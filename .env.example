# ===========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ===========================================
# Copiar este archivo a .env y configurar según el entorno

# ===========================================
# BASE DE DATOS POSTGRESQL
# ===========================================
POSTGRES_DB=turnero_peluqueria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_URL=jdbc:postgresql://db:5432/turnero_peluqueria
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_EN_PRODUCCION

# ===========================================
# BACKEND (SPRING BOOT)
# ===========================================
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=CAMBIAR_CLAVE_SECRETA_JWT_MINIMO_32_CARACTERES_ALEATORIOS
JWT_EXPIRATION=86400000
BACKEND_PORT=8080
APP_URL=http://localhost:8081
APP_NAME=Turnero Peluquería
APP_DESC=Sistema de gestión de turnos para peluquería
APP_VERSION=1.0.0
APP_DEV_NAME=Equipo Desarrollo
APP_DEV_EMAIL=dev@turnero.com

# ===========================================
# FRONTEND (ANGULAR)
# ===========================================
FRONTEND_PORT=80
API_URL=http://localhost:8080/api

# ===========================================
# WHATSAPP (META CLOUD API - OFICIAL)
# ===========================================
META_WHATSAPP_ENABLED=true
META_PHONE_NUMBER_ID=1050309724835376
META_ACCESS_TOKEN=TU_TOKEN_COMPLETO_AQUI
META_API_VERSION=v18.0
META_COUNTRY_CODE=54
META_TIMEOUT_MS=10000

# ===========================================
# RECORDATORIOS
# ===========================================
RECORDATORIOS_ENABLED=true
RECORDATORIOS_HORAS_ANTICIPACION=24

# ===========================================
# PUERTOS EXTERNOS (para DonWeb o servidor)
# ===========================================
# Si DonWeb asigna puertos específicos, cambiar aquí
DB_EXTERNAL_PORT=5432
BACKEND_EXTERNAL_PORT=8080
FRONTEND_EXTERNAL_PORT=80
